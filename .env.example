# ===== Общие =====
# Режим работы: true — демо-данные (товары из seed), false — реальный Ozon Seller API
DEMO_MODE=true

# ===== PostgreSQL =====
POSTGRES_DB=pricecube
POSTGRES_USER=pricecube
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# ===== Ozon Seller API =====
# Ключ из личного кабинета Ozon (Продавец -> API-ключи)
OZON_API_KEY=
OZON_CLIENT_ID=
OZON_API_HOST=https://api-seller.ozon.ru

# ===== Django =====
DJANGO_SECRET_KEY=change_me_to_a_long_random_string
DJANGO_DEBUG=true
